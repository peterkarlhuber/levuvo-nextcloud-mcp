# Example only. Adjust paths/users; never run under root.
# /etc/systemd/system/levuvo-nextcloud-mcp.service
[Unit]
Description=Levuvo Nextcloud Read-only MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=levuvomcp
Group=levuvomcp
WorkingDirectory=/opt/levuvo-nextcloud-mcp
EnvironmentFile=/opt/levuvo-nextcloud-mcp/.env
ExecStart=/opt/levuvo-nextcloud-mcp/.venv/bin/python -m levuvo_nextcloud_mcp --transport http
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
