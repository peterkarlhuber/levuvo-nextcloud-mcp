# Example for a Linux server of your own (not tested on a real server).
# Target: /etc/systemd/system/levuvo-nextcloud-mcp.service
#
# Preparation (as root):
#   useradd --system --home /nonexistent --shell /usr/sbin/nologin levuvomcp
#   Put the project in /opt/levuvo-nextcloud-mcp and create the venv there (see README);
#   leave the directory owned by root (the service only needs read access).
#   install -d -m 0700 -o levuvomcp -g levuvomcp /etc/levuvo-nextcloud-mcp
#   install -m 0600 -o levuvomcp -g levuvomcp .env /etc/levuvo-nextcloud-mcp/levuvo.env
#   (0600: the server warns if the file is readable by group/others.)
#
# Then: systemctl daemon-reload && systemctl enable --now levuvo-nextcloud-mcp
# Check the hardening: systemd-analyze security levuvo-nextcloud-mcp

[Unit]
Description=Levuvo Nextcloud MCP (read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=levuvomcp
Group=levuvomcp
WorkingDirectory=/opt/levuvo-nextcloud-mcp

# Configuration: the server reads the file itself (python-dotenv, same syntax as locally).
Environment=LEVUVO_MCP_ENV_FILE=/etc/levuvo-nextcloud-mcp/levuvo.env
Environment=PYTHONDONTWRITEBYTECODE=1
# Alternative: systemd sets the variables directly. Caution: systemd interprets
# quotes and special characters differently from python-dotenv. Real environment
# variables take precedence over LEVUVO_MCP_ENV_FILE.
#EnvironmentFile=/etc/levuvo-nextcloud-mcp/levuvo.env

# Listens only on 127.0.0.1:MCP_HTTP_PORT; TLS is handled by Caddy (see Caddyfile.example).
ExecStart=/opt/levuvo-nextcloud-mcp/.venv/bin/levuvo-nextcloud-mcp --transport http
Restart=on-failure
RestartSec=5

# --- Hardening ---
UMask=0077
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# If name resolution fails, add AF_NETLINK.
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
# MemoryDenyWriteExecute=true deliberately NOT set: it can cause crashes with
# some Python libraries (e.g. cffi/cryptography).

# Resources
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
