# Example for Caddy 2 on a Linux server of your own (not tested on a real server).
#
# mcp.levuvo.com is an example domain. This project does NOT set up DNS:
# an A/AAAA record must point to this server, not to the Storage Share.
# Ports 80/443 must be reachable for the automatic certificates.
# Port 8765 stays closed; the MCP service only listens on 127.0.0.1.

mcp.levuvo.com {
	# MCP requests are small; the service itself limits them to 128 KiB.
	request_body {
		max_size 256KB
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	# Host and Authorization headers are passed through unchanged
	# (the service checks the host against MCP_PUBLIC_URL).
	reverse_proxy 127.0.0.1:8765

	# Enable the access log only if needed. Caddy redacts Authorization headers
	# by default; do NOT set the global option log_credentials.

	# Rate limiting is not included in standard Caddy; optionally add it via a
	# plugin (e.g. caddy-ratelimit) or a firewall.
}
