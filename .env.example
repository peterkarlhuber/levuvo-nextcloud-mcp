# ---------------------------------- Nextcloud ---------------------------------
NEXTCLOUD_URL=https://storage.levuvo.com
NEXTCLOUD_USERNAME=agent.levuvo
NEXTCLOUD_APP_PASSWORD=EIGENES_NEXTCLOUD_APP_PASSWORT

# Standard: nur Testordner. Komma trennt mehrere Freigaben.
# Die Pfade gelten aus Sicht des Kontos agent.levuvo (nicht des Eigentümers).
# Bare paths werden mit WebDAV als Datei/Ordner erkannt.
# Für präzise Rechte optional file: (exakt eine Datei) oder dir: (Ordner + Unterordner).
NEXTCLOUD_ALLOWED_PATHS=dir:00_Agent_Test
# Beispiel gemischt (ohne # aktivieren, falls die Pfade existieren):
# NEXTCLOUD_ALLOWED_PATHS=dir:01_Unternehmen/Strategie,file:02_Finanzen/Budget_2027.xlsx,dir:05_Projekte/SaaS-Produkte
# Optionale Ausnahmen innerhalb erlaubter Pfade, Komma-getrennt.
# Denied hat Vorrang vor Allowed und sperrt bei Ordnern alle Unterordner.
NEXTCLOUD_DENIED_PATHS=
# Beispiel:
# NEXTCLOUD_DENIED_PATHS=05_Projekte/Kundenvertraege,05_Projekte/Intern/Passwoerter.md
NEXTCLOUD_MAX_FILE_BYTES=8000000
NEXTCLOUD_TIMEOUT_SECONDS=20

# -------------------------------- Remote MCP ----------------------------------
# Gueltig fuer: python -m levuvo_nextcloud_mcp --transport http
# HTTP ist NUR auf 127.0.0.1 erreichbar; TLS macht der Reverse-Proxy.
MCP_PUBLIC_URL=https://mcp.levuvo.com/mcp
MCP_HTTP_PORT=8765

# Zuerst: static (Claude Web mit festem Authorization-Header).
# Fuer ChatGPT Business / Enterprise spaeter: oauth + geeigneter IdP.
MCP_AUTH_MODE=static
# Generieren mit: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
MCP_STATIC_TOKEN=HIER_EIN_EIGENES_ZUFAELLIGES_TOKEN_MIT_MINDESTENS_32_ZEICHEN_EINTRAGEN

# Nur fuer MCP_AUTH_MODE=oauth (fuer einen externen OAuth/ OIDC Provider):
# MCP_OAUTH_ISSUER=https://login.example.com/
# MCP_OAUTH_JWKS_URL=https://login.example.com/.well-known/jwks.json
# MCP_OAUTH_AUDIENCE=https://mcp.levuvo.com/mcp
# MCP_OAUTH_SCOPE=files:read
