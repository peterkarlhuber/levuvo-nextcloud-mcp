# Levuvo Nextcloud MCP 0.5 – Beispielkonfiguration
# Kopieren nach .env, dann: chmod 600 .env
# Nur Platzhalter; echte Werte nie in Git einchecken.
# Echte Umgebungsvariablen haben Vorrang vor dieser Datei.

# ================================ Nextcloud ==================================
# HTTPS-Adresse ohne Pfad und ohne Zugangsdaten.
NEXTCLOUD_URL=https://storage.levuvo.com

# Loginname des technischen Kontos (ohne Admin-Rechte, siehe SECURITY.md).
NEXTCLOUD_USERNAME=agent.levuvo

# App-Passwort aus Nextcloud (Einstellungen > Sicherheit > Geräte & Sitzungen).
# Nicht das Login-Passwort. Hat die vollen Rechte des Kontos!
NEXTCLOUD_APP_PASSWORD=EIGENES_NEXTCLOUD_APP_PASSWORT

# Optional: WebDAV-Benutzer-ID, falls sie vom Loginnamen abweicht
# (z. B. bei Anmeldung per E-Mail-Adresse). Leer = Loginname.
NEXTCLOUD_USER_ID=

# ------------------------------- Berechtigungen ------------------------------
# Kommagetrennt, relativ zum Dateibereich von agent.levuvo, mit '/' getrennt,
# ohne führenden '/', unkodiert (Leerzeichen als Leerzeichen, nicht %20).
#   dir:Pfad   Ordner mit allen Unterordnern
#   file:Pfad  genau eine Datei
#   Pfad       Typ wird über Nextcloud erkannt
# Nur 'dir:' und 'file:' (klein) sind gültig; andere Präfixe = Startfehler.
# Nur schreibgeschützt empfangene Freigaben eintragen, nie eigene Ordner des Kontos.
NEXTCLOUD_ALLOWED_PATHS=dir:00_Agent_Test
# Beispiel:
# NEXTCLOUD_ALLOWED_PATHS=dir:01_Unternehmen/Strategie,file:02_Finanzen/Budget_2027.xlsx

# Optionale Ausnahmen innerhalb der Freigaben, gleiche Syntax.
# Sperren immer den ganzen Teilbaum, auch bei anderer Groß-/Kleinschreibung,
# und haben Vorrang. Muss unter einer Freigabe liegen, sonst Startfehler.
NEXTCLOUD_DENIED_PATHS=
# Beispiel:
# NEXTCLOUD_DENIED_PATHS=dir:01_Unternehmen/Strategie/Personal,file:01_Unternehmen/Strategie/Gehaelter.xlsx

# ---------------------------------- Limits -----------------------------------
# Downloadlimit für read_file in Bytes (1 bis 30000000).
NEXTCLOUD_MAX_FILE_BYTES=8000000
# Zeitlimit pro Nextcloud-Anfrage in Sekunden (1 bis 120).
NEXTCLOUD_TIMEOUT_SECONDS=20

# Hinweis: Den Pfad zu dieser Datei kann man mit der Umgebungsvariable
# LEVUVO_MCP_ENV_FILE angeben (z. B. in "claude mcp add --env ...").
# In dieser Datei selbst hat die Variable keine Wirkung.

# ============================ Remote (optional) ==============================
# Nur für: levuvo-nextcloud-mcp --transport http
# Der Server lauscht NUR auf 127.0.0.1; TLS macht ein Reverse-Proxy/Tunnel.
# Kein öffentlicher Betrieb ohne Checkliste in SECURITY.md.

# Öffentliche HTTPS-Adresse, muss auf /mcp enden (Beispieldomain).
MCP_PUBLIC_URL=https://mcp.levuvo.com/mcp
# Lokaler Port (1024 bis 65535).
MCP_HTTP_PORT=8765

# static = fester Bearer-Token, oauth = externer Identity Provider.
MCP_AUTH_MODE=static

# Für static: zufällig, mindestens 32 Zeichen, ohne Leerzeichen, NICHT das App-Passwort.
# Erzeugen: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
MCP_STATIC_TOKEN=HIER_EIN_EIGENES_ZUFAELLIGES_TOKEN_EINTRAGEN

# Für oauth (Werte vom Identity Provider; Issuer exakt wie im Token, inkl. '/'):
# MCP_OAUTH_ISSUER=https://login.example.com/
# MCP_OAUTH_JWKS_URL=https://login.example.com/.well-known/jwks.json
# MCP_OAUTH_AUDIENCE=https://mcp.levuvo.com/mcp
# MCP_OAUTH_SCOPE=files:read
