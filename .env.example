# Levuvo Nextcloud MCP 0.5.1 – example configuration
# Copy to .env, then: chmod 600 .env
# Placeholders only; never commit real values to Git.
# Real environment variables take precedence over this file.

# ================================ Nextcloud ==================================
# HTTPS address without path and without credentials.
NEXTCLOUD_URL=https://storage.levuvo.com

# Login name of the technical account (without admin rights, see SECURITY.md).
NEXTCLOUD_USERNAME=agent.levuvo

# App password from Nextcloud (Settings > Security > Devices & sessions,
# "Einstellungen > Sicherheit > Geräte & Sitzungen").
# Not the login password. Has the full rights of the account!
NEXTCLOUD_APP_PASSWORD=EIGENES_NEXTCLOUD_APP_PASSWORT

# Optional: WebDAV user ID, if it differs from the login name
# (e.g. when logging in with an email address). Empty = login name.
NEXTCLOUD_USER_ID=

# -------------------------------- Permissions --------------------------------
# Comma-separated, relative to the file area of agent.levuvo, separated by '/',
# without leading '/', unencoded (spaces as spaces, not %20).
#   dir:path   folder including all subfolders
#   file:path  exactly one file
#   path       type is detected via Nextcloud
# Only 'dir:' and 'file:' (lowercase) are valid; other prefixes = startup error.
# Only enter shares received read-only, never folders owned by the account.
# The name must exactly match the folder name as agent.levuvo sees it in
# Nextcloud: the Levuvo test folder is "00_Agent Test" with a space (not
# 00_Agent_Test). Write the space literally, without quotes and without %20.
NEXTCLOUD_ALLOWED_PATHS=dir:00_Agent Test
# Example:
# NEXTCLOUD_ALLOWED_PATHS=dir:01_Unternehmen/Strategie,file:02_Finanzen/Budget_2027.xlsx

# Optional exceptions within the released entries, same syntax.
# Always block the whole subtree, also with different case,
# and take precedence. Must lie under a released entry, otherwise startup error.
NEXTCLOUD_DENIED_PATHS=
# Example:
# NEXTCLOUD_DENIED_PATHS=dir:01_Unternehmen/Strategie/Personal,file:01_Unternehmen/Strategie/Gehaelter.xlsx

# ---------------------------------- Limits -----------------------------------
# Download limit for read_file in bytes (1 to 100000000, default 25000000).
# Measured on a 1 GB server: see docs/PERFORMANCE_0.5.2.md before raising it.
NEXTCLOUD_MAX_FILE_BYTES=25000000
# Timeout per Nextcloud request in seconds (1 to 120).
NEXTCLOUD_TIMEOUT_SECONDS=20

# Server-side caps for search_files (since 0.5.3). They only bound the search, never access.
# Per-call defaults stay max_depth=3 and max_results=25. Without these lines the 0.5.2 limits apply.
# Highest max_depth a call may use (3 to 20, default 6).
NEXTCLOUD_SEARCH_MAX_DEPTH=6
# Folders scanned at most per call (1 to 1000, default 100). 1000 folders can take tens of seconds.
NEXTCLOUD_SEARCH_MAX_DIRECTORIES=100
# Highest max_results a call may use (25 to 500, default 100).
NEXTCLOUD_SEARCH_MAX_RESULTS=100
# Example for a larger structure:
# NEXTCLOUD_MAX_FILE_BYTES=100000000
# NEXTCLOUD_SEARCH_MAX_DEPTH=20
# NEXTCLOUD_SEARCH_MAX_DIRECTORIES=1000
# NEXTCLOUD_SEARCH_MAX_RESULTS=500
# Changes take effect only after the MCP process is restarted.

# Note: the path to this file can be given with the environment variable
# LEVUVO_MCP_ENV_FILE (e.g. in "claude mcp add --env ...").
# Inside this file itself, the variable has no effect.

# ============================ Remote (optional) ==============================
# Only for: levuvo-nextcloud-mcp --transport http
# The server listens ONLY on 127.0.0.1; TLS is handled by a reverse proxy/tunnel.
# No public operation without the checklist in SECURITY.md.

# Public HTTPS address, must end in /mcp (example domain).
MCP_PUBLIC_URL=https://mcp.levuvo.com/mcp
# Local port (1024 to 65535).
MCP_HTTP_PORT=8765

# static = fixed bearer token, oauth = external identity provider.
MCP_AUTH_MODE=static

# For static: random, at least 32 characters, no whitespace, NOT the app password.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
MCP_STATIC_TOKEN=HIER_EIN_EIGENES_ZUFAELLIGES_TOKEN_EINTRAGEN

# For oauth (values from the identity provider; issuer exactly as in the token, incl. '/'):
# MCP_OAUTH_ISSUER=https://login.example.com/
# MCP_OAUTH_JWKS_URL=https://login.example.com/.well-known/jwks.json
# MCP_OAUTH_AUDIENCE=https://mcp.levuvo.com/mcp
# MCP_OAUTH_SCOPE=files:read
